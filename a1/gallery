<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>BookVerse - Gallery</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Elms+Sans:wght@400;500;600;700&family=Righteous&display=swap"
        rel="stylesheet">

    <link
        href="https://fonts.googleapis.com/icon?family=Material+Icons"
        rel="stylesheet">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        rel="stylesheet"
        href="assets/css/style.css">

</head>

<body>

<header>

    <nav class="navbar navbar-expand-lg navbar-dark">

        <div class="container">

            <a
                class="navbar-brand d-flex align-items-center"
                href="index.html">

                <span class="material-icons me-2">
                    menu_book
                </span>

                BookVerse

            </a>


            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavigation"
                aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>


            <div
                class="collapse navbar-collapse"
                id="mainNavigation">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a
                            class="nav-link"
                            href="index.html">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link"
                            href="books.html">
                            Books
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link active"
                            href="gallery.html">
                            Gallery
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link"
                            href="add.html">
                            Add Book
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

</header>


<main>

    <section class="page-header">

        <div class="container">

            <h1>Book Gallery</h1>

            <p>
                Explore our collection of book covers.
            </p>

        </div>

    </section>


    <section class="py-5">

        <div class="container">

            <div class="row g-4">

                <div class="col-6 col-md-4 col-lg-3">

                    <button
                        type="button"
                        class="gallery-button"
                        data-bs-toggle="modal"
                        data-bs-target="#imageModal"
                        data-image="assets/images/covers/book1.jpg"
                        data-title="Book Title One">

                        <img
                            src="assets/images/covers/book1.jpg"
                            class="gallery-image"
                            alt="Book Title One">

                    </button>

                </div>


                <div class="col-6 col-md-4 col-lg-3">

                    <button
                        type="button"
                        class="gallery-button"
                        data-bs-toggle="modal"
                        data-bs-target="#imageModal"
                        data-image="assets/images/covers/book2.jpg"
                        data-title="Book Title Two">

                        <img
                            src="assets/images/covers/book2.jpg"
                            class="gallery-image"
                            alt="Book Title Two">

                    </button>

                </div>


                <div class="col-6 col-md-4 col-lg-3">

                    <button
                        type="button"
                        class="gallery-button"
                        data-bs-toggle="modal"
                        data-bs-target="#imageModal"
                        data-image="assets/images/covers/book3.jpg"
                        data-title="Book Title Three">

                        <img
                            src="assets/images/covers/book3.jpg"
                            class="gallery-image"
                            alt="Book Title Three">

                    </button>

                </div>


                <div class="col-6 col-md-4 col-lg-3">

                    <button
                        type="button"
                        class="gallery-button"
                        data-bs-toggle="modal"
                        data-bs-target="#imageModal"
                        data-image="assets/images/covers/book4.jpg"
                        data-title="Book Title Four">

                        <img
                            src="assets/images/covers/book4.jpg"
                            class="gallery-image"
                            alt="Book Title Four">

                    </button>

                </div>


                <div class="col-6 col-md-4 col-lg-3">

                    <button
                        type="button"
                        class="gallery-button"
                        data-bs-toggle="modal"
                        data-bs-target="#imageModal"
                        data-image="assets/images/covers/book5.jpg"
                        data-title="Book Title Five">

                        <img
                            src="assets/images/covers/book5.jpg"
                            class="gallery-image"
                            alt="Book Title Five">

                    </button>

                </div>


                <div class="col-6 col-md-4 col-lg-3">

                    <button
                        type="button"
                        class="gallery-button"
                        data-bs-toggle="modal"
                        data-bs-target="#imageModal"
                        data-image="assets/images/covers/book6.jpg"
                        data-title="Book Title Six">

                        <img
                            src="assets/images/covers/book6.jpg"
                            class="gallery-image"
                            alt="Book Title Six">

                    </button>

                </div>

            </div>

        </div>

    </section>

</main>


<div
    class="modal fade"
    id="imageModal"
    tabindex="-1"
    aria-labelledby="imageModalLabel"
    aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h2
                    class="modal-title fs-5"
                    id="imageModalLabel">
                    Book Cover
                </h2>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close">
                </button>

            </div>


            <div class="modal-body text-center">

                <img
                    id="modalImage"
                    src=""
                    alt=""
                    class="modal-book-image">

            </div>

        </div>

    </div>

</div>


<footer>

    <div class="container text-center">

        <p>
            &copy; 2026 BookVerse | YOUR NAME
        </p>

    </div>

</footer>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

<script src="assets/js/scripts.js"></script>

</body>
</html>