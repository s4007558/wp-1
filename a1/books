<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>BookVerse - Books</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Elms+Sans:wght@400;500;600;700&family=Righteous&display=swap"
        rel="stylesheet">

    <link
        href="https://fonts.googleapis.com/icon?family=Material+Icons"
        rel="stylesheet">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        rel="stylesheet"
        href="assets/css/style.css">

</head>

<body>

<header>

    <nav class="navbar navbar-expand-lg navbar-dark">

        <div class="container">

            <a
                class="navbar-brand d-flex align-items-center"
                href="index.html">

                <span class="material-icons me-2">
                    menu_book
                </span>

                BookVerse

            </a>


            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavigation"
                aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>


            <div
                class="collapse navbar-collapse"
                id="mainNavigation">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a
                            class="nav-link"
                            href="index.html">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link active"
                            href="books.html">
                            Books
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link"
                            href="gallery.html">
                            Gallery
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link"
                            href="add.html">
                            Add Book
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

</header>


<main>

    <section class="page-header">

        <div class="container">

            <h1>Browse Books</h1>

            <p>
                Browse books currently listed on BookVerse.
            </p>

        </div>

    </section>


    <section class="py-5">

        <div class="container">

            <div class="filter-container mb-4">

                <button
                    type="button"
                    class="btn btn-primary filter-button"
                    data-filter="all">

                    All

                </button>


                <button
                    type="button"
                    class="btn btn-outline-primary filter-button"
                    data-filter="Available">

                    Available

                </button>


                <button
                    type="button"
                    class="btn btn-outline-primary filter-button"
                    data-filter="Reserved">

                    Reserved

                </button>


                <button
                    type="button"
                    class="btn btn-outline-primary filter-button"
                    data-filter="Sold">

                    Sold

                </button>

            </div>


            <div class="table-responsive">

                <table class="table table-bordered table-hover">

                    <thead>

                        <tr>

                            <th>Title</th>
                            <th>Author</th>
                            <th>Genre</th>
                            <th>Year</th>
                            <th>Condition</th>
                            <th>Price</th>
                            <th>Status</th>

                        </tr>

                    </thead>


                    <tbody id="booksTable">

                        <tr data-status="Available">

                            <td>The Great Adventure</td>
                            <td>John Smith</td>
                            <td>Adventure</td>
                            <td>2022</td>
                            <td>New</td>
                            <td>$25.00</td>

                            <td>
                                <span class="status available">
                                    Available
                                </span>
                            </td>

                        </tr>


                        <tr data-status="Reserved">

                            <td>Beyond the Stars</td>
                            <td>Sarah Jones</td>
                            <td>Science Fiction</td>
                            <td>2021</td>
                            <td>Gently Used</td>
                            <td>$18.00</td>

                            <td>
                                <span class="status reserved">
                                    Reserved
                                </span>
                            </td>

                        </tr>


                        <tr data-status="Sold">

                            <td>The Hidden City</td>
                            <td>Michael Brown</td>
                            <td>Mystery</td>
                            <td>2019</td>
                            <td>Fair</td>
                            <td>$12.00</td>

                            <td>
                                <span class="status sold">
                                    Sold
                                </span>
                            </td>

                        </tr>


                        <tr data-status="Available">

                            <td>Learning Web Design</td>
                            <td>Jane Wilson</td>
                            <td>Technology</td>
                            <td>2024</td>
                            <td>New</td>
                            <td>$35.00</td>

                            <td>
                                <span class="status available">
                                    Available
                                </span>
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </section>

</main>


<footer>

    <div class="container text-center">

        <p>
            &copy; 2026 BookVerse | Joseph Saba
        </p>

    </div>

</footer>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

<script src="assets/js/scripts.js"></script>

</body>
</html>